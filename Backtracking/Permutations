class Solution:
    def permute(self, nums):
        res = []
        used = [False] * len(nums)

        def backtrack(path):
            if len(path) == len(nums):
                res.append(path[:])
                return

            for i in range(len(nums)):
                if used[i]:
                    continue

                # choose
                used[i] = True
                path.append(nums[i])

                backtrack(path)

                # undo
                path.pop()
                used[i] = False

        backtrack([])
        return res
